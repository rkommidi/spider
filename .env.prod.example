# Production Environment Variables
# Copy this file to .env.prod and fill in actual values
# ⚠️  NEVER commit .env.prod to version control!

# =====================================
# Docker Registry
# =====================================
DOCKER_USERNAME=your-dockerhub-username

# =====================================
# Database Configuration
# =====================================
DB_PASSWORD=your-secure-production-password-here

# =====================================
# Website Credentials
# =====================================
WEBSITE_USERNAME=your-website-username
WEBSITE_PASSWORD=your-website-password
LOGIN_URL=https://now.breakthrubev.com/bbg/en/login

# =====================================
# Flask Configuration
# =====================================
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# =====================================
# Portainer Configuration (for Jenkins deployment)
# =====================================
PORTAINER_URL=http://your-nas-ip:9000
PORTAINER_API_KEY=your-portainer-api-key-here

# =====================================
# Monitoring (Phase 4)
# =====================================
# GRAFANA_ADMIN_PASSWORD=your-grafana-password
# PROMETHEUS_RETENTION=15d
