# Web Scraping Credentials
WEBSITE_USERNAME=your_username_here
WEBSITE_PASSWORD=your_password_here

# PostgreSQL Configuration
POSTGRES_PASSWORD=change_this_to_a_secure_password

# Database Configuration (PostgreSQL - recommended for production)
DATABASE_URL=postgresql://spider:change_this_to_a_secure_password@postgres:5432/spider

# Alternative: SQLite (for local testing)
# DATABASE_PATH=data/products.db
# Leave DATABASE_URL unset to use SQLite

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
