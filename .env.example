# Spider Price Tracker - Environment Variables Example
# Copy this file to .env and fill in your actual values

# =====================================
# Database Configuration
# =====================================
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://spider:your_secure_password_here@postgres:5432/spider_dev

# For production, use different password and db name:
# DATABASE_URL=postgresql://spider:prod_password@postgres:5432/spider_prod

# =====================================
# Flask Configuration
# =====================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Production settings:
# FLASK_ENV=production
# FLASK_DEBUG=False

# =====================================
# Scraper Credentials
# =====================================
WEBSITE_USERNAME=your_website_username
WEBSITE_PASSWORD=your_website_password

# =====================================
# CI/CD Configuration (for Jenkins)
# =====================================
DOCKER_REGISTRY=your-dockerhub-username
PORTAINER_URL=http://your-nas-ip:9000
PORTAINER_API_KEY=your_portainer_api_key

# =====================================
# Optional: Monitoring
# =====================================
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=INFO
